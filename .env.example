# Video Highlights configuration. Copy to .env (docker compose and the
# native scripts read it). Every VH_* variable read by the code is listed;
# commented-out lines show the default.
#
# Windows paths: use forward slashes, e.g. VH_MEDIA_DIR=D:/Videos

# --- Container / host wiring (docker-compose.yml) -------------------------
# Host folder with source matches, mounted read-only at /media in every
# container. In the Studio use "Local file on the server": /media/<file>.mp4
VH_MEDIA_DIR=./media
# VH_MEDIA_DIR=D:/Videos                 # Windows -> /media
# VH_MEDIA_DIR=/Users/me/Movies/Matches  # macOS (CPU containers only)
# Host port for the API + Studio UI.
VH_API_PORT=8000
# Image names used by compose (set to pull published images instead of building).
# VH_IMAGE_CPU=video-highlights:cpu
# VH_IMAGE_GPU=video-highlights:gpu
# GPU image build args. DGX Spark (arm64, CUDA 13):
#   VH_CUDA_IMAGE=nvidia/cuda:13.0.1-base-ubuntu24.04
#   VH_TORCH_INDEX=cu130
# VH_CUDA_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04
# VH_TORCH_INDEX=cu128
# 1 = install TensorRT + ONNX in the GPU image (needed for VH_TENSORRT=1).
# VH_INSTALL_TENSORRT=0
# Detector weights baked into the images at build time.
# VH_MODELS=yolov8n.pt yolov8s.pt

# --- Storage, database, queue --------------------------------------------
# Containers default to the named volume vh-data mounted at /data.
# VH_DB_URL=sqlite:////data/db/video_highlights.db
# Postgres (compose --profile cloud, or a managed DB):
# VH_DB_URL=postgresql+psycopg://vh:vh@postgres:5432/video_highlights
# VH_OUTPUT_ROOT=/data/outputs
# VH_LOCAL_STORAGE_ROOT=/data/storage
# inline = API runs jobs in-process (native single-user); queue = separate worker.
# VH_JOB_EXECUTION_MODE=queue
# Inline-mode thread pool size.
# VH_JOB_MAX_WORKERS=2
# local | s3
# VH_STORAGE_BACKEND=local
# VH_S3_ENDPOINT_URL=https://s3.example.com
# VH_S3_BUCKET=video-highlights
# VH_S3_REGION=us-east-1
# VH_S3_ACCESS_KEY_ID=
# VH_S3_SECRET_ACCESS_KEY=
# VH_S3_KEY_PREFIX=video-highlights
# Postgres container credentials (compose --profile cloud).
# POSTGRES_USER=vh
# POSTGRES_PASSWORD=vh
# POSTGRES_DB=video_highlights

# --- Processing hardware ---------------------------------------------------
# auto | cuda | cuda:1 | mps | cpu
VH_DEVICE=auto
# Detector weights directory (containers: /models; native: <repo>/models).
# VH_MODEL_DIR=/models
# Swap the profile default weights for another family of the same size:
# yolov8 (default) | yolo11 | yolo26   e.g. balanced -> yolo26s.pt
# VH_MODEL_FAMILY=yolov8
# 1 = export/cached TensorRT engine on CUDA (needs VH_INSTALL_TENSORRT=1 image).
# VH_TENSORRT=0
# ffmpeg location overrides: VH_FFMPEG / VH_FFPROBE are full executable paths,
# VH_FFMPEG_BIN is a directory containing ffmpeg(.exe)/ffprobe(.exe).
# VH_FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
# VH_FFPROBE=C:/ffmpeg/bin/ffprobe.exe
# VH_FFMPEG_BIN=C:/ffmpeg/bin
# RNNoise model for the audio editor's denoise filter.
# VH_RNNOISE_MODEL_PATH=

# --- Auth / tenancy -------------------------------------------------------
# VH_AUTH_REQUIRED=false
# token:role pairs, comma separated.
# VH_API_TOKENS=admin-token:admin,coach-token:coach
# VH_AUTH_BOOTSTRAP_KEY=
# VH_JWT_SECRET=change-me-32-chars-minimum........
# VH_JWT_ALGORITHM=HS256
# VH_JWT_ISSUER=video-highlights
# VH_JWT_AUDIENCE=
# VH_JWT_DEFAULT_EXP_MINUTES=120
# Dev shortcut: auto-provision tenant membership (compose default true).
# VH_SKIP_USER_MANAGEMENT=true
# VH_BASE_TENANT_SLUG=sandbox
# VH_BASE_TENANT_NAME=Sandbox Tenant

# --- Uploads, SLA, notifications ------------------------------------------
# Standard and entitlement-gated extended upload caps (GB).
# VH_UPLOAD_MAX_GB=3
# VH_UPLOAD_EXTENDED_MAX_GB=8
# Minimum source duration (s); 0 disables, 1800 = 30-minute product rule.
# VH_UPLOAD_MIN_DURATION_SECONDS=0
# Turnaround target shown in the UI (hours).
# VH_PROCESSING_SLA_HOURS_MIN=4
# VH_PROCESSING_SLA_HOURS_MAX=6
# console | smtp | disabled
# VH_NOTIFY_BACKEND=console
# VH_SMTP_HOST=smtp.example.com
# VH_SMTP_PORT=587
# VH_SMTP_USERNAME=
# VH_SMTP_PASSWORD=
# VH_SMTP_FROM=no-reply@video-highlights.local
# VH_SMTP_STARTTLS=true

# --- Logging ----------------------------------------------------------------
# VH_TEST_MODE=false          # true also flips the two below to DEBUG/extreme
# VH_LOG_LEVEL=INFO
# VH_JOB_LOG_DETAIL=basic     # basic | detailed | extreme
# VH_PERSIST_JOB_LOGS=true

# --- LLM (match reports + assistant) ----------------------------------------
# none | openai | ollama | openai_compatible
# VH_LLM_PROVIDER=none
# VH_LLM_MODEL=gpt-4o-mini
# Ollama on the Docker host: http://host.docker.internal:11434
# VH_LLM_BASE_URL=
# VH_LLM_API_KEY=
# VH_LLM_TIMEOUT_SECONDS=20
# VH_LLM_KEEP_ALIVE=0
# OPENAI_API_KEY=
